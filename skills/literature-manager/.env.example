# Literature Manager 凭据模板
#
# 推荐放到用户级配置（不跟技能目录走，也不会被提交）：
#   mkdir -p ~/.config/papergate
#   cp .env.example ~/.config/papergate/literature.env
#   chmod 600 ~/.config/papergate/literature.env
#
# 也可以用环境变量指定路径：PAPERGATE_LITERATURE_ENV=/path/to/literature.env
# 仍兼容旧位置：skills/literature-manager/.env

# OpenAlex API Key（可选，不填有速率限制 ~100 次/天）
OPENALEX_API_KEY=

# Zotero Web API（用于 pull/push/sync）
ZOTERO_API_KEY=
ZOTERO_USER_ID=
